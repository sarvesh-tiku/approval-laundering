# Any OpenAI-compatible chat-completions endpoint. No key is needed for the deterministic experiments.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Comma-separated model IDs, as the provider names them.
LLM_MODELS=
# Hard stop for one run_llm_trials invocation, in USD (uses provider-reported usage when available).
LLM_BUDGET_USD=10
